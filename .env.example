# Copy to `.env` and adjust. docker compose reads it automatically.
# Everything is optional except the two secrets, which you should set in production.

# --- Secrets ---------------------------------------------------------------
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Bearer token for /api/admin/*, the monitor, metrics and export endpoints.
# If empty, the admin API is disabled and the monitor is locked (unless MONITOR_PUBLIC=true).
ADMIN_TOKEN=

# --- Access control --------------------------------------------------------
# true = the monitor endpoints need no token (only for a private network)
MONITOR_PUBLIC=false
# Comma-separated origins allowed to call the API from a browser. Empty = same-origin only.
CORS_ORIGINS=

# --- Outbound scanning -----------------------------------------------------
# true = allow checks against private / internal addresses (internal PKI). Keep false on anything public.
ALLOW_PRIVATE_TARGETS=false

# --- Rate limiting ---------------------------------------------------------
# docker compose sets redis://redis:6379 for you; memory:// is per process and resets on restart.
RATE_LIMIT_STORAGE_URI=redis://redis:6379

# --- Expiry alerts for monitored certificates and domains ------------------
ALERT_THRESHOLDS=30,14,7,1          # days before expiry
ALERT_CHECK_INTERVAL_HOURS=12       # 0 disables the background scheduler
ALERT_WEBHOOK_URL=                  # Slack, Teams or any JSON webhook
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=                     # comma-separated

# --- Integrations ----------------------------------------------------------
CT_API_URL=https://crt.sh/          # Certificate Transparency search service
CT_CACHE_SECONDS=900                # cache CT results per domain; 0 disables
RBL_RESOLVERS=                      # your own DNS resolver for blocklist checks (Spamhaus refuses public resolvers)
RBL_LISTS=                          # comma-separated DNSBL zones to replace the defaults
ACME_DNS_RESOLVERS=1.1.1.1,8.8.8.8  # resolvers used to confirm dns-01 TXT propagation

# Image tag used by `docker compose pull` (default: latest), e.g. 1.0.0
# SSL_TOOLKIT_VERSION=1.0.0
