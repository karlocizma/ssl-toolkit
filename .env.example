# Copy to `.env` and adjust. docker compose reads it automatically.
# Everything is optional except the two secrets, which you should set in production.
# Keep comments on their own line: some tools (Podman, Portainer, --env-file) treat text after a value
# as part of the value.

# --- Secrets ---------------------------------------------------------------
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Bearer token for /api/admin/*, the monitor, metrics and export endpoints.
# If empty, the admin API is disabled and the monitor is locked (unless MONITOR_PUBLIC=true).
ADMIN_TOKEN=

# --- Access control --------------------------------------------------------
# true = the monitor endpoints need no token (only for a private network)
MONITOR_PUBLIC=false
# Comma-separated origins allowed to call the API from a browser. Empty = same-origin only.
CORS_ORIGINS=

# --- Outbound scanning -----------------------------------------------------
# true = allow checks against private / internal addresses (internal PKI). Keep false on anything public.
ALLOW_PRIVATE_TARGETS=false

# --- Rate limiting ---------------------------------------------------------
# docker compose sets redis://redis:6379 for you; memory:// is per process and resets on restart.
RATE_LIMIT_STORAGE_URI=redis://redis:6379

# --- Expiry alerts for monitored certificates and domains ------------------
# Days before expiry at which alerts are sent
ALERT_THRESHOLDS=30,14,7,1
# 0 disables the background scheduler
ALERT_CHECK_INTERVAL_HOURS=12
# Slack or any generic JSON webhook
ALERT_WEBHOOK_URL=
# Microsoft Teams (Workflows webhook URL)
ALERT_TEAMS_WEBHOOK_URL=
# Public URL of this app, adds a button to Teams alerts
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Comma-separated
ALERT_EMAIL_TO=

# --- Integrations ----------------------------------------------------------
# Certificate Transparency search service
CT_API_URL=https://crt.sh/
# Heading of the public status page (STATUS_PAGE_ENABLED=false turns the page off)
STATUS_PAGE_TITLE=Certificate status
# Rotate the audit log at this size in bytes (AUDIT_LOG_KEEP=5 rotated files are kept)
AUDIT_LOG_MAX_BYTES=5242880
# Cache domain registration (RDAP) lookups for this many seconds; 0 disables
RDAP_CACHE_SECONDS=21600
# Cache CT results per domain for this many seconds; 0 disables
CT_CACHE_SECONDS=900
# Your own DNS resolver (IP address) for blocklist checks; Spamhaus refuses public resolvers
RBL_RESOLVERS=
# Comma-separated DNSBL zones to replace the defaults
RBL_LISTS=
# Resolvers used to confirm dns-01 TXT propagation
ACME_DNS_RESOLVERS=1.1.1.1,8.8.8.8

# Image tag used by `docker compose pull` (default: latest), e.g. 1.0.0
# SSL_TOOLKIT_VERSION=1.0.0
